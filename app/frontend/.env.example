VITE_API_BACKEND=http://localhost:5001/
# matches local if set for `secret`
VITE_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJyb2xlcyI6WyJmZWVkYmFjayIsImNoYXQiXX0.d91fM8UyKsP2c_3rJQqrkESudlZPZpTRifidN8jghtI

# local (163dev)
VITE_AZURE_AD_CLIENT_ID=something
VITE_AZURE_AD_TENANT_ID=something

VITE_ALLOWED_TOOLS=geds,corporate,archibus,pmcoe,telecom

VITE_BLOB_STORAGE_URL="https://<something>.blob.core.windows.net/"
VITE_SAS_TOKEN="sv=2022-11-02&....."

VITE_CLARITY_TOKEN="tokenId"

# Deployment environment for frontend behavior toggles (dev, sandbox, uat, prod).
VITE_APP_ENV=dev

# Google Analytics 4 measurement ID (enabled only when VITE_APP_ENV=prod)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

#feature flag playground
VITE_PLAYGROUND_ON=false
VITE_PLAYGROUND_USE_LITELLM=true
# Show playground Cloud Sync indicator in session list when true. Defaults to false if not set.
VITE_PLAYGROUND_SHOW_CLOUD_SYNC_INDICATOR=false
# LiteLLM is now reached through the API backend (same-origin /api/playground/litellm/v1),
# so the browser never holds the master key. Leave empty to use the same-origin default;
# set only to override with an explicit absolute URL (must include /v1).
VITE_PLAYGROUND_LITELLM_BASE_URL=
# Deprecated: LiteLLM auth is now handled server-side by the API backend. Leave empty.
VITE_PLAYGROUND_LITELLM_SCOPE=
# Optional explicit model sent to LiteLLM (for example: azure/gpt-4o).
VITE_LITELLM_MODEL=
# PMCOE blob container prefix used when current MCP payloads include filenames but omit source_path.
VITE_PMCOE_CONTAINER=pmcoe-sept-2025
# Call orchestrator first (if configured) before sending final LiteLLM request.
VITE_PLAYGROUND_ORCHESTRATOR_PREFLIGHT=true

#configurations for title renaming
TITLE_RENAME_THRESHOLD=1

VITE_DISABLED_FEATURES=FileUpload,FeedbackForm,chat_history_import_export

VITE_SHOW_DEV_BANNER=true
VITE_PLAYGROUND_SHOW_ORCHESTRATOR_DEBUG=false

VITE_MCP_SERVERS='[
	{
		"server_label": "Orchestrator MCP",
		"server_description": "MCP orchestrator server that classifies chat context and recommends downstream MCP routes.",
		"server_url": "http://127.0.0.1:8000/mcp",
		"require_approval": "never"
	}
        ]'