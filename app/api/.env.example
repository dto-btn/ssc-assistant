AZURE_SEARCH_SERVICE_ENDPOINT=https://<domain>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<key>
AZURE_OPENAI_ENDPOINT=https://<domain>.openai.azure.com

GEDS_API_TOKEN=secret
DATABASE_ENDPOINT=https://<something>.table.core.windows.net/
BLOB_ENDPOINT=https://<something>.blob.core.windows.net/

AZURE_AD_CLIENT_ID=api://<app-uuid>
AZURE_AD_TENANT_ID=d05bc194-94bf-4ad6-ae2e-1db0f2e38f5e

# OPTIONAL PARAMETERS
SKIP_USER_VALIDATION=False
ALLOWED_TOOLS=geds,corporate,archibus,pmcoe,telecom
AZURE_SEARCH_INDEX_NAME=current
ARCHIBUS_API_USERNAME=user
ARCHIBUS_API_PASSWORD=pass

BITS_DB_SERVER=domain:1234
BITS_DB_DATABASE=databaseName
BITS_DB_USERNAME=username
BITS_DB_PWD=password

# Playground LiteLLM + orchestrator proxying (server-side).
# The frontend calls /api/playground/litellm/* and /api/playground/orchestrator/*; the API
# injects the LiteLLM master key (X-Litellm-Key) and, when a scope is set, a managed-identity
# token (Authorization) for App Service Easy Auth. The master key stays server-side only.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=
# Prod only: api://<litellm-app-client-id>/.default (leave empty for local proxy without Easy Auth).
LITELLM_SCOPE=
ORCHESTRATOR_URL=http://localhost:8000
# Prod only: api://<orchestrator-app-client-id>/.default (leave empty for local).
ORCHESTRATOR_SCOPE=

# Server-owned MCP registry (JSON array). The API serves a sanitized view (ids/labels, no
# URLs) to the browser and expands opaque `mcpref:<id>` refs to these real endpoints before
# forwarding to LiteLLM. `id` must match the orchestrator's mcp_server_id (e.g. bits_mcp).
# Optional per-server `headers` are injected server-side. Include an orchestrator entry so the
# frontend can detect it and exclude it from downstream tool routing.
PLAYGROUND_MCP_SERVERS='[{"id":"orchestrator_mcp","server_label":"Orchestrator-MCP","server_description":"Classifies chat context and recommends downstream MCP routes.","server_url":"http://localhost:8000/mcp"}]'
